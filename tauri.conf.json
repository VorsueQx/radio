{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tactical Radio",
  "version": "1.0.0",
  "identifier": "com.irmakstudio.tacticalradio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tactical Radio",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://ahmetyyilmaz.com.tr https://*.relay.metered.ca stun: turn: turns:; media-src 'self' blob:; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
